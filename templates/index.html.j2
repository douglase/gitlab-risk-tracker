<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Risk Dashboard — {{ group_path }}</title>
<style>
  :root {
    --bg: #fafafa;
    --fg: #222;
    --muted: #666;
    --border: #ddd;
    --low: #e8f5e9;
    --medium: #fff9c4;
    --high: #ffe0b2;
    --critical: #ffcdd2;
    --unscored: #eceff1;
  }
  body { font: 14px/1.4 system-ui, sans-serif; color: var(--fg); background: var(--bg); margin: 0; padding: 1.5rem; }
  h1 { margin: 0 0 .25rem 0; font-size: 1.4rem; }
  .meta { color: var(--muted); margin-bottom: 1rem; }
  .filters { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; margin-bottom: 1rem; padding: .75rem; background: white; border: 1px solid var(--border); border-radius: 6px; }
  .filters label { display: flex; flex-direction: column; gap: .25rem; font-size: 12px; color: var(--muted); }
  .filters select, .filters input { padding: .25rem .5rem; font: inherit; min-width: 140px; }
  .filters select[multiple] { min-width: 160px; }
  .filters .hint { font-size: 10px; color: #aaa; font-weight: normal; }
  .filters button { padding: .35rem .75rem; font: inherit; background: white; border: 1px solid var(--border); border-radius: 4px; cursor: pointer; align-self: end; }
  .filters button:hover { background: #f5f5f5; }
  table.matrix { border-collapse: collapse; margin-bottom: 1.5rem; }
  table.matrix th, table.matrix td { border: 1px solid var(--border); padding: .5rem; vertical-align: top; min-width: 110px; height: 90px; }
  table.matrix th { background: white; font-weight: 600; text-align: center; }
  table.matrix td { cursor: pointer; position: relative; }
  table.matrix td.low { background: var(--low); }
  table.matrix td.medium { background: var(--medium); }
  table.matrix td.high { background: var(--high); }
  table.matrix td.critical { background: var(--critical); }
  table.matrix td.unscored { background: var(--unscored); }
  td .count { font-weight: 700; font-size: 1.2rem; }
  td ul { margin: .25rem 0 0 0; padding: 0; list-style: none; font-size: 11px; }
  td ul li a { color: #1565c0; text-decoration: none; }
  td.selected { outline: 3px solid #1565c0; outline-offset: -3px; }
  .axis-label { font-weight: 600; color: var(--muted); padding: .25rem; }
  .legend { display: flex; gap: .5rem; align-items: center; font-size: 12px; margin-bottom: .5rem; }
  .legend span { padding: .1rem .5rem; border: 1px solid var(--border); border-radius: 3px; }
  section { background: white; border: 1px solid var(--border); border-radius: 6px; padding: 1rem; margin-bottom: 1rem; }
  section h2 { margin: 0 0 .75rem 0; font-size: 1rem; }
  .detail-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .detail-table th, .detail-table td { padding: .35rem .5rem; border-bottom: 1px solid var(--border); text-align: left; }
  .detail-table th { color: var(--muted); font-weight: 600; }
  .movement-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: .75rem; }
  .movement-grid .card { padding: .5rem; border: 1px solid var(--border); border-radius: 4px; }
  .movement-grid .card h3 { margin: 0 0 .35rem 0; font-size: .9rem; }
  .movement-grid .card ul { margin: 0; padding-left: 1.1rem; font-size: 12px; }
  .bar { display: flex; align-items: center; gap: .5rem; margin: .25rem 0; }
  .bar .label { width: 110px; font-size: 12px; color: var(--muted); }
  .bar .fill { background: #90caf9; height: 14px; border-radius: 2px; }
  .bar .n { font-size: 12px; color: var(--muted); }
  .trend { width: 100%; height: 200px; }
  .hidden { display: none; }
</style>
</head>
<body>

<h1>Risk Dashboard — {{ group_path }}</h1>
<div class="meta">Last updated: {{ generated_at }}</div>

<div class="filters">
  <label>Subsystem <span class="hint">(⌘/Ctrl-click for multi)</span>
    <select id="f-subsystem" multiple size="5">
      {% for s in subsystems %}<option value="{{ s }}">{{ s }}</option>{% endfor %}
    </select>
  </label>
  <label>Priority
    <select id="f-priority">
      <option value="">All</option>
      {% for p in priorities %}<option value="{{ p }}">{{ p }}</option>{% endfor %}
    </select>
  </label>
  <label>Risk type
    <select id="f-risktype">
      <option value="">All</option>
      {% for r in risk_types %}<option value="{{ r }}">{{ r }}</option>{% endfor %}
    </select>
  </label>
  {% for grp in label_groups_meta %}
  {% if label_options[grp.key] %}
  <label>{{ grp.label }} <span class="hint">(multi)</span>
    <select id="f-{{ grp.key }}" data-group="{{ grp.key }}" multiple size="5">
      {% for v in label_options[grp.key] %}<option value="{{ v }}">{{ v }}</option>{% endfor %}
    </select>
  </label>
  {% endif %}
  {% endfor %}
  <button type="button" id="clear-filters">Clear filters</button>
  <span class="legend">
    <span class="low">low (1–4)</span>
    <span class="medium">medium (5–9)</span>
    <span class="high">high (10–15)</span>
    <span class="critical">critical (16–25)</span>
  </span>
</div>

<table class="matrix">
  <tr>
    <th></th>
    <th colspan="5">Likelihood →</th>
  </tr>
  <tr>
    <th rowspan="6" class="axis-label">Consequence ↑</th>
    <th></th>
    {% for l in cols %}<th>L = {{ l }}</th>{% endfor %}
  </tr>
  {% for c in rows %}
  <tr>
    <th>C = {{ c }}</th>
    {% for l in cols %}
      {% set issues = matrix.cells[(c, l)] %}
      {% set tier = severity_tier(c, l) %}
      <td class="{{ tier }}" data-cell="{{ c }}-{{ l }}" onclick="selectCell('{{ c }}-{{ l }}')">
        <div class="count">0</div>
        <ul></ul>
      </td>
    {% endfor %}
  </tr>
  {% endfor %}
</table>

<section id="detail-section" class="hidden">
  <h2>Selected cell — <span id="detail-label"></span></h2>
  <table class="detail-table">
    <thead><tr><th>ID</th><th>Title</th></tr></thead>
    <tbody id="detail-body"></tbody>
  </table>
</section>

<section>
  <h2>Trend — issues by severity tier (last 90 days)</h2>
  <svg class="trend" id="trend-chart" viewBox="0 0 800 200" preserveAspectRatio="none"></svg>
</section>

<section>
  <h2>Movement (last 30 days)</h2>
  <div class="movement-grid">
    <div class="card">
      <h3>↑ Escalated ({{ movement.escalated | length }})</h3>
      <ul>{% for r in movement.escalated[:10] %}<li><a href="{{ r.web_url }}" target="_blank">#{{ r.iid }}</a> → C{{ r.consequence }}×L{{ r.likelihood }}</li>{% endfor %}</ul>
    </div>
    <div class="card">
      <h3>↓ De-escalated ({{ movement.deescalated | length }})</h3>
      <ul>{% for r in movement.deescalated[:10] %}<li><a href="{{ r.web_url }}" target="_blank">#{{ r.iid }}</a> → C{{ r.consequence }}×L{{ r.likelihood }}</li>{% endfor %}</ul>
    </div>
    <div class="card">
      <h3>✚ New ({{ movement.new | length }})</h3>
      <ul>{% for r in movement.new[:10] %}<li><a href="{{ r.web_url }}" target="_blank">{{ r.title | clean_title | truncate(45) }}</a></li>{% endfor %}</ul>
    </div>
    <div class="card">
      <h3>✔ Closed ({{ movement.closed | length }})</h3>
      <ul>{% for r in movement.closed[:10] %}<li><a href="{{ r.web_url }}" target="_blank">#{{ r.iid }}</a></li>{% endfor %}</ul>
    </div>
  </div>
</section>

<section>
  <h2>Subsystem breakdown (label occurrences)</h2>
  {% set max_count = subsystem_counts.values() | max | default(1) %}
  {% for s in subsystems %}
    {% set n = subsystem_counts.get(s, 0) %}
    <div class="bar">
      <span class="label">{{ s }}</span>
      <div class="fill" style="width: {{ (n / max_count * 300) | round }}px;"></div>
      <span class="n">{{ n }}</span>
    </div>
  {% endfor %}
</section>

<script>
const cells = {{ cells_json | safe }};
const trends = {{ trends | tojson }};

const MAX_TITLE_CHARS = 38;

function escapeHtml(s) {
  return (s || '').replace(/[&<>"']/g, c => (
    { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
  ));
}

function truncate(s, n) {
  if (!s) return '';
  return s.length > n ? s.slice(0, n) + '…' : s;
}

function getMulti(id) {
  const el = document.getElementById(id);
  if (!el) return [];
  return Array.from(el.selectedOptions).map(o => o.value).filter(v => v !== '');
}

const LABEL_GROUP_KEYS = Array.from(document.querySelectorAll('select[data-group]'))
  .map(el => el.dataset.group);

function currentFilter() {
  const f = {
    subs: getMulti('f-subsystem'),
    pri:  document.getElementById('f-priority').value,
    rt:   document.getElementById('f-risktype').value,
    groups: {},
  };
  LABEL_GROUP_KEYS.forEach(k => { f.groups[k] = getMulti('f-' + k); });
  return f;
}

function matchesFilter(item, f) {
  if (f.subs.length && !f.subs.some(s => (item.subsystems || []).includes(s))) return false;
  if (f.pri && item.priority !== f.pri) return false;
  if (f.rt && !(item.risk_types || []).includes(f.rt)) return false;
  for (const k of LABEL_GROUP_KEYS) {
    const selected = f.groups[k];
    if (selected.length === 0) continue;
    const itemVals = (item.label_groups && item.label_groups[k]) || [];
    if (!selected.some(v => itemVals.includes(v))) return false;
  }
  return true;
}

let selectedKey = null;

function selectCell(key) {
  selectedKey = key;
  document.querySelectorAll('table.matrix td').forEach(td => td.classList.remove('selected'));
  const td = document.querySelector(`td[data-cell="${key}"]`);
  if (td) td.classList.add('selected');
  renderDetail();
}

function renderDetail() {
  if (!selectedKey) return;
  const f = currentFilter();
  const issues = (cells[selectedKey] || []).filter(i => matchesFilter(i, f));
  const [c, l] = selectedKey.split('-');
  document.getElementById('detail-label').textContent =
    `Consequence ${c} × Likelihood ${l} (${issues.length} issues)`;
  const body = document.getElementById('detail-body');
  body.innerHTML = issues.map(i =>
    `<tr><td><a href="${i.web_url}" target="_blank">#${escapeHtml(i.iid)}</a></td>` +
    `<td>${escapeHtml(i.display_title || i.title)}</td></tr>`
  ).join('') || '<tr><td colspan="2" style="color:#999">No issues match the current filter</td></tr>';
  document.getElementById('detail-section').classList.remove('hidden');
}

function drawTrend() {
  const svg = document.getElementById('trend-chart');
  const W = 800, H = 200, PAD_L = 30, PAD_B = 20;
  const tiers = ['low', 'medium', 'high', 'critical'];
  const colors = { low: '#81c784', medium: '#fff176', high: '#ffb74d', critical: '#e57373' };
  const N = trends.labels.length;
  if (N === 0) return;
  let maxY = 1;
  tiers.forEach(t => trends.series[t].forEach(v => { if (v > maxY) maxY = v; }));
  const xStep = (W - PAD_L) / Math.max(N - 1, 1);
  const yScale = v => H - PAD_B - (v / maxY) * (H - PAD_B - 10);
  let svgInner = '';
  tiers.forEach(t => {
    const pts = trends.series[t].map((v, i) => `${PAD_L + i * xStep},${yScale(v)}`).join(' ');
    svgInner += `<polyline fill="none" stroke="${colors[t]}" stroke-width="2" points="${pts}"/>`;
  });
  svgInner += `<line x1="${PAD_L}" y1="${H - PAD_B}" x2="${W}" y2="${H - PAD_B}" stroke="#999"/>`;
  svgInner += `<line x1="${PAD_L}" y1="0" x2="${PAD_L}" y2="${H - PAD_B}" stroke="#999"/>`;
  svgInner += `<text x="${W - 5}" y="${H - 5}" text-anchor="end" font-size="11" fill="#666">${trends.labels[N - 1]}</text>`;
  svgInner += `<text x="${PAD_L}" y="${H - 5}" font-size="11" fill="#666">${trends.labels[0]}</text>`;
  svgInner += `<text x="5" y="12" font-size="11" fill="#666">${maxY}</text>`;
  let lx = PAD_L + 10;
  tiers.forEach(t => {
    svgInner += `<rect x="${lx}" y="6" width="10" height="10" fill="${colors[t]}"/>`;
    svgInner += `<text x="${lx + 14}" y="15" font-size="11" fill="#444">${t}</text>`;
    lx += 80;
  });
  svg.innerHTML = svgInner;
}

function applyFilters() {
  const f = currentFilter();
  document.querySelectorAll('table.matrix td[data-cell]').forEach(td => {
    const key = td.dataset.cell;
    const all = cells[key] || [];
    const filtered = all.filter(i => matchesFilter(i, f));
    td.querySelector('.count').textContent = filtered.length;
    const head = filtered.slice(0, 4).map(i => {
      const title = i.display_title || i.title || '';
      return `<li><a href="${i.web_url}" target="_blank">${escapeHtml(truncate(title, MAX_TITLE_CHARS))}</a></li>`;
    }).join('');
    const tail = filtered.length > 4 ? `<li>… +${filtered.length - 4} more</li>` : '';
    td.querySelector('ul').innerHTML = head + tail;
  });
  renderDetail();
}

document.querySelectorAll('.filters select').forEach(el => el.addEventListener('change', applyFilters));
document.getElementById('clear-filters').addEventListener('click', () => {
  document.querySelectorAll('.filters select').forEach(el => {
    Array.from(el.options).forEach(o => o.selected = false);
    if (!el.multiple) el.value = '';
  });
  applyFilters();
});
applyFilters();
drawTrend();
</script>

</body>
</html>
